{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postbuild": "node scripts/harden-static-html.mjs",
    "test:security-html": "node --test scripts/harden-static-html.test.mjs scripts/eslint-glob.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "^13.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "fast-glob": "file:vendor/next-eslint-glob",
    "parse5": "8.0.1"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    }
  }
}
